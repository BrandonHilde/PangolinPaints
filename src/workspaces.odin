package pangolin

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strconv"
import "core:strings"

// A workspace is the tool set-up: tool groups (including the pen eraser group), swatches and
// per-tool brush settings. The same lines are stored in the preferences file. Built-in
// workspaces are generated by code; user workspaces are `<name>.ppws` files in the
// `workspaces` folder next to the executable and can be exported / imported anywhere.

WS_MAX :: 32
WS_EXT :: ".ppws"

Ws_Entry :: struct {
	name:    string,
	path:    string, // saved workspaces only
	builtin: int, // index into WS_BUILTIN_NAMES, or -1 for a saved workspace
}

WS_BUILTIN_NAMES := [?]string{"Default", "Painting", "Photo Editing", "Sketching"}

ws_entries: [dynamic]Ws_Entry
ws_current: string // name of the workspace applied last (not remembered between runs)

FILTERS_WS := [?]Filter{{"Pangolin Paints workspace (*.ppws)", "*.ppws"}, {"All files", "*.*"}}

// ---------------------------------------------------------------------------
// Serialization (shared with the preferences file)
// ---------------------------------------------------------------------------

workspace_write :: proc(sb: ^strings.Builder) {
	group_save_brushes()
	for t in Tool {
		if !paint_tool(t) do continue
		b := &brushes[t]
		fmt.sbprintf(sb, "size_%d=%d\nopacity_%d=%d\npreset_%d=%d\n", int(t), b.size, int(t), b.opacity, int(t), brush_preset_idx[t])
	}
	fmt.sbprintf(sb, "groups=%s\n", tool_groups_serialize())
	fmt.sbprintf(sb, "swatches=")
	for c, i in swatches {
		fmt.sbprintf(sb, "%s%s", i > 0 ? "," : "", color_hex(c))
	}
	fmt.sbprintf(sb, "\n")
}

// Applies one `key=value` line if it belongs to a workspace.
workspace_apply_line :: proc(key, sval: string) -> bool {
	switch key {
	case "groups":
		tool_groups_parse(sval)
		group_key_wait = -1
		return true
	case "swatches":
		list := make([dynamic]Color, context.temp_allocator)
		for part in strings.split(sval, ",", context.temp_allocator) {
			if c, ok := parse_hex(part); ok {
				append(&list, c)
			}
		}
		if len(list) > 0 {
			clear(&swatches)
			append(&swatches, ..list[:])
			swatch_sel = clamp(swatch_sel, 0, len(swatches) - 1)
		}
		return true
	}
	// per-tool brush settings: preset first so size/opacity can override it
	for prefix in ([?]string{"preset_", "size_", "opacity_"}) {
		if !strings.has_prefix(key, prefix) do continue
		ti, tok := strconv.parse_int(key[len(prefix):])
		val, vok := strconv.parse_int(sval)
		if !tok || !vok || ti < 0 || ti >= len(Tool) || !paint_tool(Tool(ti)) do return true
		t := Tool(ti)
		switch prefix {
		case "preset_":
			if val >= 0 && val < len(presets) && presets[val].tool == t {
				brush_preset_idx[t] = val
				brushes[t] = presets[val].b
			}
		case "size_":
			brushes[t].size = clamp(val, 1, BRUSH_MAX)
		case "opacity_":
			brushes[t].opacity = clamp(val, 1, 100)
		}
		return true
	}
	return false
}

workspace_text :: proc() -> string {
	sb := strings.builder_make(context.temp_allocator)
	fmt.sbprintf(&sb, "ppws=1\n")
	workspace_write(&sb)
	return strings.to_string(sb)
}

// Applies workspace text; false (and nothing changed) if it holds no tool groups.
workspace_apply_text :: proc(text: string) -> bool {
	if !strings.contains(text, "groups=") {
		return false
	}
	rest := text
	for line in strings.split_lines_iterator(&rest) {
		eq := strings.index_byte(line, '=')
		if eq < 0 do continue
		workspace_apply_line(strings.trim_space(line[:eq]), strings.trim_space(line[eq + 1:]))
	}
	return true
}

// ---------------------------------------------------------------------------
// Built-in workspaces
// ---------------------------------------------------------------------------

@(private = "file")
ws_group :: proc(name: string, key: KeyboardKey, pen: bool, tools: ..Tool) {
	g := Tool_Group {
		key        = key,
		last       = tools[0],
		pen_eraser = pen,
	}
	name_set(&g.name, name)
	append(&g.tools, ..tools)
	append(&tool_groups, g)
}

workspace_builtin :: proc(i: int) {
	switch i {
	case 0:
		tool_groups_default()
	case 1:
		tool_groups_clear()
		ws_group("Paint", .ONE, false, .Brush, .Oil, .Smudge, .Blur, .Dodge)
		ws_group("Fill and Pick", .TWO, false, .Picker, .Bucket, .Gradient, .Clone)
		ws_group("Navigate", .THREE, false, .Hand, .Zoom, .Move, .Transform)
		ws_group("Pen", .KEY_NULL, true, .Eraser, .Smudge)
	case 2:
		tool_groups_clear()
		ws_group("Select", .ONE, false, .Select_Rect, .Select_Ellipse, .Lasso, .Wand)
		ws_group("Frame", .TWO, false, .Crop, .Move, .Transform)
		ws_group("Retouch", .THREE, false, .Clone, .Blur, .Dodge, .Smudge, .Picker)
		ws_group("Mark", .FOUR, false, .Brush, .Line, .Eraser, .Text)
		ws_group("View", .FIVE, false, .Hand, .Zoom)
	case 3:
		tool_groups_clear()
		ws_group("Draw", .ONE, false, .Brush, .Line, .Eraser, .Smudge)
		ws_group("Colour", .TWO, false, .Picker, .Bucket, .Gradient)
		ws_group("View", .THREE, false, .Hand, .Zoom)
		ws_group("Pen", .KEY_NULL, true, .Eraser, .Smudge)
	}
	group_key_wait = -1
	if len(tool_groups) > 0 && len(tool_groups[0].tools) > 0 {
		select_tool_in_group(tool_groups[0].tools[0], 0)
	}
}

// ---------------------------------------------------------------------------
// Saved workspaces
// ---------------------------------------------------------------------------

ws_dir :: proc() -> string {
	return fmt.tprintf("%sworkspaces/", gfx_app_dir())
}

ws_path_for :: proc(name: string) -> string {
	return fmt.tprintf("%s%s%s", ws_dir(), name, WS_EXT)
}

// Strips characters that cannot go in a file name.
ws_clean_name :: proc(s: string) -> string {
	sb := strings.builder_make(context.temp_allocator)
	for r in strings.trim_space(s) {
		switch r {
		case '\\', '/', ':', '*', '?', '"', '<', '>', '|':
		case:
			strings.write_rune(&sb, r)
		}
	}
	return strings.trim_space(strings.to_string(sb))
}

ws_refresh :: proc() {
	for e in ws_entries {
		delete(e.name)
		delete(e.path)
	}
	clear(&ws_entries)
	for n, i in WS_BUILTIN_NAMES {
		append(&ws_entries, Ws_Entry{name = strings.clone(n), builtin = i})
	}
	files, err := os.read_directory_by_path(ws_dir(), -1, context.temp_allocator)
	if err != nil {
		return
	}
	saved := make([dynamic]Ws_Entry, context.temp_allocator)
	for f in files {
		if f.type == .Directory || lower_ext(f.name) != WS_EXT do continue
		append(&saved, Ws_Entry{name = strings.clone(path_stem(f.name)), path = strings.clone(f.fullpath), builtin = -1})
	}
	slice.sort_by(saved[:], proc(a, b: Ws_Entry) -> bool {
		return strings.compare(strings.to_lower(a.name, context.temp_allocator), strings.to_lower(b.name, context.temp_allocator)) < 0
	})
	for e in saved {
		if len(ws_entries) >= WS_MAX do break
		append(&ws_entries, e)
	}
}

workspace_apply_index :: proc(i: int) {
	if i < 0 || i >= len(ws_entries) do return
	e := ws_entries[i]
	if e.builtin >= 0 {
		workspace_builtin(e.builtin)
	} else {
		data, ok := read_file(e.path)
		if !ok {
			show_message("Workspace", fmt.tprintf("Cannot read %s", path_basename(e.path)))
			return
		}
		defer delete(data)
		if !workspace_apply_text(string(data)) {
			show_message("Workspace", "This is not a valid workspace file.")
			return
		}
	}
	delete(ws_current)
	ws_current = strings.clone(e.name)
	set_statusf("Workspace: %s", e.name)
}

// Saves the current set-up under `name` in the workspaces folder.
workspace_save_named :: proc(name: string) -> bool {
	n := ws_clean_name(name)
	if n == "" {
		set_status("Enter a name for the workspace")
		return false
	}
	os.make_directory_all(ws_dir())
	if !write_file(ws_path_for(n), transmute([]u8)workspace_text()) {
		show_message("Workspace", "Could not write the workspace file.")
		return false
	}
	delete(ws_current)
	ws_current = strings.clone(n)
	set_statusf("Saved workspace %s", n)
	return true
}

workspace_delete_index :: proc(i: int) {
	if i < 0 || i >= len(ws_entries) || ws_entries[i].builtin >= 0 do return
	os.remove(ws_entries[i].path)
	set_statusf("Deleted workspace %s", ws_entries[i].name)
}

workspace_export :: proc() {
	initial := fmt.tprintf("%s%s", ws_current != "" ? ws_current : "workspace", WS_EXT)
	os.make_directory_all(ws_dir())
	p, ok := native_dialog(true, "Export workspace", FILTERS_WS[:], "ppws", initial, ws_dir())
	if !ok do return
	defer delete(p)
	if write_file(p, transmute([]u8)workspace_text()) {
		set_statusf("Exported workspace to %s", path_basename(p))
	} else {
		show_message("Workspace", "Could not write the workspace file.")
	}
}

// Loads a workspace file, applies it and keeps a copy in the workspaces folder.
workspace_import :: proc() {
	p, ok := native_dialog(false, "Import workspace", FILTERS_WS[:], "ppws", "", ws_dir())
	if !ok do return
	defer delete(p)
	data, rok := read_file(p)
	if !rok {
		show_message("Workspace", fmt.tprintf("Cannot read %s", path_basename(p)))
		return
	}
	defer delete(data)
	if !workspace_apply_text(string(data)) {
		show_message("Workspace", "This is not a valid workspace file.")
		return
	}
	name := ws_clean_name(path_stem(p))
	if name != "" {
		os.make_directory_all(ws_dir())
		write_file(ws_path_for(name), data)
		delete(ws_current)
		ws_current = strings.clone(name)
	}
	set_statusf("Imported workspace %s", path_basename(p))
}

// ---------------------------------------------------------------------------
// Dialog
// ---------------------------------------------------------------------------

dlg_workspaces :: proc() {
	c := dialog_frame("Workspaces", 320, 150)
	y := c.y
	@(static) names: [WS_MAX]string
	n := len(ws_entries)
	for e, i in ws_entries do names[i] = e.name
	dialog.a = clamp(dialog.a, 0, n - 1)
	text(c.x, y + 3, "Workspace", C_TEXT)
	if nv, ch := combo(Rect{c.x + 80, y, c.w - 80, 14}, names[:n], dialog.a); ch {
		dialog.a = nv
	}
	y += 22
	if button(Rect{c.x, y, 60, 16}, "Load", "Switch to the selected workspace") {
		workspace_apply_index(dialog.a)
	}
	saved := ws_entries[dialog.a].builtin < 0
	if button(Rect{c.x + 66, y, 60, 16}, "Delete", "Delete the selected saved workspace", saved) {
		workspace_delete_index(dialog.a)
		ws_refresh()
	}
	y += 24
	text(c.x, y + 3, "Save as", C_TEXT)
	text_field(Rect{c.x + 80, y, c.w - 80 - 66, 14}, &dialog.name, "Name for the current tool set-up")
	if button(Rect{c.x + c.w - 60, y - 1, 60, 16}, "Save", "Save the current tool set-up as a workspace") {
		if workspace_save_named(name_str(&dialog.name)) {
			ws_refresh()
			for e, i in ws_entries {
				if e.builtin < 0 && e.name == ws_current do dialog.a = i
			}
		}
	}
	y += 24
	if button(Rect{c.x, y, 80, 16}, "Import...", "Load a workspace file and add it to the list") {
		workspace_import()
		ws_refresh()
	}
	if button(Rect{c.x + 86, y, 80, 16}, "Export...", "Save the current tool set-up to a workspace file") {
		workspace_export()
	}
	ok, _ := dialog_buttons(c, "Close", "")
	if ok {
		dialog_close()
	}
}
